# ========================================================
# TerraBreath AI - Environment Configuration
# ========================================================

# [Optional] Google Gemini AI API Key
# Used for server-side Explainable AI (XAI) synthesis and grounding.
# Get a free key at: https://aistudio.google.com/
# If omitted, deterministic algorithms and authentic heuristic XAI synthesis will be used.
GEMINI_API_KEY=""

# [Optional] Application Port for local development or Docker
# Default: 3000
PORT=3000

# [Optional] Node Environment: "development" or "production"
NODE_ENV=development

# [Optional] App URL (used for absolute callbacks if needed)
APP_URL="http://localhost:3000"
